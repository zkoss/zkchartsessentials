<zk>
    <charts type="pie" title="中文" id="chart"/>
    <zscript><![CDATA[
        import org.zkoss.chart.model.*;
        import org.zkoss.chart.*;

        PieModel model = new DefaultPieModel();
        model.setValue("台北", 12.5);
        model.setValue("台中", 50.2);
        model.setValue("台南", 20.5);
        model.setValue("高雄", 15.5);

        chart.setModel(model);

		// Load a web-accessible TTF font for local PDF export.
        PDFFont font = chart.getExporting().getPdfFont();
		font.setNormal("fonts/NotoSansTC-Regular.ttf");

		// Send export requests to an export server instead of browser-local export.
		// chart.getExporting().setLocal(false);
    ]]></zscript>
</zk>
